generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PRINCIPAL
  TEACHER
  ACCOUNTANT
  STUDENT
  PARENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacherProfile  Teacher?
  studentProfile  Student?
  guardianProfile Guardian?
  announcements   Announcement[]
  paymentsTaken   FeePayment[]
  expensesAdded   Expense[]
  attendanceMarks Attendance[]
}

model Teacher {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId    String?  @unique
  phone         String?
  qualification String?
  position      String?
  /// Monthly base salary in PKR.
  baseSalary    Int      @default(0)
  joinedOn      DateTime @default(now())

  classesLed Class[]
  salaries   SalaryRecord[]
  courses    Course[]
}

model Guardian {
  id       String    @id @default(cuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone    String?
  students Student[]
}

model Class {
  id             String  @id @default(cuid())
  name           String
  section        String  @default("A")
  academicYear   String
  classTeacherId String?
  classTeacher   Teacher? @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  /// Monthly tuition fee in PKR for every student of this class.
  monthlyFee     Int     @default(0)

  students Student[]
  courses  Course[]
  exams    Exam[]

  @@unique([name, section, academicYear])
}

model Student {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber  String
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  guardianId  String?
  guardian    Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  dateOfBirth DateTime?
  gender      String?
  address     String?
  admittedOn  DateTime  @default(now())
  /// Monthly discount in PKR taken off the class fee (concession, sibling discount, etc.).
  feeDiscount Int       @default(0)
  /// Monthly fee set for this student. When empty, the class fee (less any discount) is used.
  monthlyFee  Int?

  invoices     FeeInvoice[]
  marks        Mark[]
  attendance   Attendance[]
  boardRecords BoardRecord[]

  @@unique([classId, rollNumber])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    Role[]
  isPublic    Boolean  @default(false)
  publishedAt DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  @@index([publishedAt])
}

enum ApplicationStatus {
  NEW
  CONTACTED
  ACCEPTED
  DECLINED
}

/// Submitted from the public admissions form.
model AdmissionApplication {
  id             String            @id @default(cuid())
  childName      String
  dateOfBirth    DateTime          @db.Date
  gender         String
  classApplied   String
  previousSchool String?
  guardianName   String
  phone          String
  email          String?
  address        String?
  notes          String?
  status         ApplicationStatus @default(NEW)
  createdAt      DateTime          @default(now())

  @@index([createdAt])
}

/// Submitted from the public contact form.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One monthly fee bill per student. `month` is "YYYY-MM".
enum FeeType {
  ADMISSION
  MONTHLY
  EXAM
}

model FeeInvoice {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  month     String
  /// Admission, monthly tuition or exam fee.
  type      FeeType  @default(MONTHLY)
  /// Amount due in PKR (fixed when the fee is created).
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  payments FeePayment[]

  @@index([studentId, month, type])
  @@index([month])
  @@index([type])
}

model FeePayment {
  id           String     @id @default(cuid())
  receiptNo    Int        @unique @default(autoincrement())
  invoiceId    String
  invoice      FeeInvoice @relation(fields: [invoiceId], references: [id])
  amount       Int
  paidOn       DateTime   @default(now())
  method       String     @default("Cash")
  note         String?
  receivedById String?
  receivedBy   User?      @relation(fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([paidOn])
}

/// Monthly salary line for a teacher. `month` is "YYYY-MM".
model SalaryRecord {
  id            String    @id @default(cuid())
  teacherId     String
  teacher       Teacher   @relation(fields: [teacherId], references: [id])
  month         String
  baseSalary    Int
  allowances    Int       @default(0)
  /// Days the teacher was off this month; deductions = baseSalary / 30 x daysOff.
  daysOff       Int       @default(0)
  deductions    Int       @default(0)
  note          String?
  paidOn        DateTime?

  @@unique([teacherId, month])
  @@index([month])
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  category    String
  description String
  amount      Int
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

/// A subject taught at the school (Mathematics, English...).
model Subject {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
  marks   Mark[]
}

/// A subject taught to one class, optionally with its teacher.
model Course {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  slots TimetableSlot[]

  @@unique([classId, subjectId])
}

/// One lesson in a class timetable. `day`: 1 = Monday ... 6 = Saturday.
model TimetableSlot {
  id        String @id @default(cuid())
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  day       Int
  startTime String
  endTime   String

  @@index([courseId])
}

/// A test or examination for one class (monthly test, mid-term, final...).
model Exam {
  id          String    @id @default(cuid())
  name        String
  kind        String
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  examDate    DateTime? @db.Date
  totalMarks  Int       @default(100)
  passPercent Int       @default(33)
  createdAt   DateTime  @default(now())

  marks Mark[]

  @@index([classId])
}

model Mark {
  id        String  @id @default(cuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// null = not entered yet (or absent).
  obtained  Int?

  @@unique([examId, studentId, subjectId])
}

/// Board examination details for Class 9 and 10 students.
model BoardRecord {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examYear       String
  boardRollNo    String?
  registrationNo String?
  groupName      String?
  result         String?
  updatedAt      DateTime @updatedAt

  @@unique([studentId, examYear])
}

model Attendance {
  id          String           @id @default(cuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  status      AttendanceStatus
  markedById  String?
  markedBy    User?            @relation(fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([date])
}
