generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PRINCIPAL
  TEACHER
  ACCOUNTANT
  STUDENT
  PARENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacherProfile  Teacher?
  studentProfile  Student?
  guardianProfile Guardian?
  announcements   Announcement[]
  paymentsTaken   FeePayment[]
  expensesAdded   Expense[]
}

model Teacher {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId    String?  @unique
  phone         String?
  qualification String?
  position      String?
  /// Monthly base salary in PKR.
  baseSalary    Int      @default(0)
  joinedOn      DateTime @default(now())

  classesLed Class[]
  salaries   SalaryRecord[]
}

model Guardian {
  id       String    @id @default(cuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone    String?
  students Student[]
}

model Class {
  id             String  @id @default(cuid())
  name           String
  section        String  @default("A")
  academicYear   String
  classTeacherId String?
  classTeacher   Teacher? @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  /// Monthly tuition fee in PKR for every student of this class.
  monthlyFee     Int     @default(0)

  students Student[]

  @@unique([name, section, academicYear])
}

model Student {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber  String
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  guardianId  String?
  guardian    Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  dateOfBirth DateTime?
  gender      String?
  address     String?
  admittedOn  DateTime  @default(now())
  /// Monthly discount in PKR taken off the class fee (concession, sibling discount, etc.).
  feeDiscount Int       @default(0)

  invoices FeeInvoice[]

  @@unique([classId, rollNumber])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    Role[]
  isPublic    Boolean  @default(false)
  publishedAt DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  @@index([publishedAt])
}

enum ApplicationStatus {
  NEW
  CONTACTED
  ACCEPTED
  DECLINED
}

/// Submitted from the public admissions form.
model AdmissionApplication {
  id             String            @id @default(cuid())
  childName      String
  dateOfBirth    DateTime          @db.Date
  gender         String
  classApplied   String
  previousSchool String?
  guardianName   String
  phone          String
  email          String?
  address        String?
  notes          String?
  status         ApplicationStatus @default(NEW)
  createdAt      DateTime          @default(now())

  @@index([createdAt])
}

/// Submitted from the public contact form.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One monthly fee bill per student. `month` is "YYYY-MM".
model FeeInvoice {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  month     String
  /// Amount due in PKR (class fee minus the student's discount, fixed when the invoice is created).
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  payments FeePayment[]

  @@unique([studentId, month])
  @@index([month])
}

model FeePayment {
  id           String     @id @default(cuid())
  receiptNo    Int        @unique @default(autoincrement())
  invoiceId    String
  invoice      FeeInvoice @relation(fields: [invoiceId], references: [id])
  amount       Int
  paidOn       DateTime   @default(now())
  method       String     @default("Cash")
  note         String?
  receivedById String?
  receivedBy   User?      @relation(fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([paidOn])
}

/// Monthly salary line for a teacher. `month` is "YYYY-MM".
model SalaryRecord {
  id            String    @id @default(cuid())
  teacherId     String
  teacher       Teacher   @relation(fields: [teacherId], references: [id])
  month         String
  baseSalary    Int
  allowances    Int       @default(0)
  deductions    Int       @default(0)
  note          String?
  paidOn        DateTime?

  @@unique([teacherId, month])
  @@index([month])
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  category    String
  description String
  amount      Int
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([date])
}
