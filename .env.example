# Copy this file to .env for local development. NEVER commit .env.
# On Netlify, add the same variables under Site configuration > Environment variables.

# Neon POOLED connection string (host contains "-pooler"). Used by the running app.
# If Neon adds "&channel_binding=require" to the URL, delete that part (keep sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon DIRECT connection string (no "-pooler"). Used only by Prisma migrations and seeding.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Random secret for Auth.js. Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Public URL of the site. Local: http://localhost:3000   Netlify: https://YOUR-SITE.netlify.app
AUTH_URL="http://localhost:3000"

# Password given to the demo users by the seed script (change it, test site only).
SEED_PASSWORD="ChangeMe123!"
